# Settings of the relay_tracking Brevo collector: copy to brevo-collector.conf (chmod 600, owned by the user running
# the collector) and adapt.

# Relay folder, mounted (read-only is enough) in the Roundcube container under $config['relay_tracking_dir']/brevo
RELAY_DIR=/srv/roundcube/relays/brevo

# Sender domains whose mail goes out through Brevo (space separated). Events of other senders on the same Brevo
# account are left out.
DOMAINS="example.org"

# Brevo API key (file holding only the key, chmod 600, outside any Git repository).
# Needed: transactional statistics (read).
API_KEY_FILE=/root/.config/brevo/api_key

# Lock folder (root 700)
#STATE_DIR=/var/lib/relay-tracking-brevo

# Keep the IP address of each event (open, click, delivery...), shown on hover in Roundcube. These are the
# recipients' IPs (or their provider's proxy): personal data, so off by default.
#INCLUDE_IP=0

# Event window (days, 90 max at Brevo) and publication delay shown in Roundcube
#EVENT_DAYS=90
#LAG="up to 1-2 h"
